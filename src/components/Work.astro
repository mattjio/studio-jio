---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';
import ProjectCard from './ProjectCard.astro';
import { pad, site } from '../site';

const projects = (await getCollection('projects', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
const [lead, side] = projects;
const years = [...new Set(projects.map((p) => p.data.year))].join(' · ');
const nextIndex = pad(projects.length + 1);
---
<section id="work" class="section" aria-labelledby="work-title">
  <div class="site-wrap">
    <SectionHead id="work-title" title="Selected work" meta={`${pad(projects.length)} projects · ${years}`} />
    <div class="grid-12 gap-y-16 lg:gap-y-[72px]">
      {lead && <ProjectCard project={lead} ratio="4/5" speed={0.04} class="col-span-12 lg:col-span-7" />}
      {side && <ProjectCard project={side} ratio="3/4" speed={0.16} class="col-span-12 lg:col-span-4 lg:col-start-9 lg:mt-40" />}
      <a href="#contact" data-reveal="up" data-cursor="Let's talk" data-cursor-theme="light" class="col-span-12 flex aspect-video max-w-full flex-col justify-between border-[1.5px] border-navy p-7 no-underline transition-colors duration-200 hover:bg-navy hover:text-bone lg:col-span-8 lg:col-start-3">
        <span class="meta">{nextIndex} · Next project · 2027</span>
        <span class="text-[clamp(36px,5vw,72px)] font-[550] leading-[0.98] tracking-[-0.035em]">Yours could be here.</span>
        <span class="meta">{site.ctaLabel} →</span>
      </a>
    </div>
  </div>
</section>

---
// A framed, full-page screenshot. Shows the top of the page at rest; the rest of the
// page scrolls through the frame on hover (scripts/motion.ts).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; alt: string; ratio: string; href: string; cursor?: string }
const { src, alt, ratio, href, cursor = 'View site' } = Astro.props;
---
<a href={href} target="_blank" rel="noopener" data-cursor={cursor} class="block" aria-label={`${alt} (opens live site)`}>
  <div data-shot class="relative max-w-full overflow-hidden bg-frame" style={`aspect-ratio:${ratio}`}>
    <Image data-shot-img src={src} alt={alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 60vw, 100vw" class="absolute inset-x-0 top-0 block h-auto w-full will-change-transform" />
  </div>
</a>

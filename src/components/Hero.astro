---
import { site } from '../site';
import HeroReel from './HeroReel.astro';
---
<section data-hero class="overflow-x-clip pt-[clamp(64px,8vw,120px)] pb-12">
  <div class="site-wrap">
    <h1 data-hero-title class="text-[clamp(54px,10.4vw,170px)] leading-[0.94]">{site.headline}</h1>
    <div class="grid-12 mt-12 gap-y-12 lg:mt-20">
      <div class="col-span-12 grid content-start justify-items-start gap-8 lg:col-span-5">
        <p data-intro class="max-w-[38ch] text-xl text-charcoal">
          Studio Jio plans, designs and builds websites for founders and local businesses. We start with what the
          site has to do, then make every page earn its place.
        </p>
        <a data-intro data-magnetic class="btn btn-navy" href="#contact">{site.ctaLabel} <span aria-hidden="true">→</span></a>
      </div>
      <div data-intro class="col-span-12 lg:col-span-6 lg:col-start-7">
        <HeroReel />
      </div>
    </div>
    <div class="relative mt-16 pt-4 lg:mt-24">
      <span data-intro-rule class="absolute inset-x-0 top-0 h-px bg-rule" aria-hidden="true"></span>
      <div class="meta flex flex-wrap justify-between gap-x-10 gap-y-2">
        <span data-intro>{site.tagline}</span>
        <span data-intro>Strategy · Design · Build</span>
        <span data-intro>{site.location}</span>
        <span data-intro>{site.availability}</span>
      </div>
    </div>
  </div>
</section>

---
import { site } from '../site';
---
<section id="contact" class="bg-navy text-bone" aria-labelledby="contact-title">
  <div class="site-wrap py-20 lg:py-32">
    <div class="grid-12">
      <h2 id="contact-title" data-reveal="lines" class="col-span-12 text-[clamp(44px,7vw,112px)] lg:col-span-9">Have a business that deserves a clearer website?</h2>
      <div class="col-span-12 mt-14 flex flex-wrap items-center gap-x-12 gap-y-6">
        <a data-magnetic class="btn btn-bone" href={`mailto:${site.email}?subject=New%20project`}>{site.callLabel} <span aria-hidden="true">→</span></a>
        <a class="font-mono text-[15px] no-underline hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </div>
</section>

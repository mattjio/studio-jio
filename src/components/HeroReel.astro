---
// Hero showreel: project screenshots cycle with a wipe, ending on an open "your project" slide.
// Without JS the first slide simply shows.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { pad } from '../site';

const projects = (await getCollection('projects', ({ data }) => data.featured && !!data.image)).sort((a, b) => a.data.order - b.data.order);
const total = projects.length + 1;
---
<a href="#work" data-reel data-cursor="See the work" class="group block" aria-label="See selected work">
  <div class="relative aspect-[16/10] max-w-full overflow-hidden bg-navy">
    {projects.map((p, i) => (
      <div data-reel-slide class:list={['absolute inset-0 overflow-hidden', i > 0 && 'reel-hidden']}>
        <Image data-reel-img src={p.data.image!} alt={`${p.data.title} website`} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" class="absolute inset-x-0 top-0 block h-auto w-full will-change-transform" />
        <div class="meta absolute inset-x-0 bottom-0 flex justify-between gap-4 bg-band px-4 py-3 text-band-ink">
          <span>{pad(i + 1)} / {pad(total)} · {p.data.title}</span><span class="max-sm:hidden">{p.data.sector} · {p.data.year}</span>
        </div>
      </div>
    ))}
    <div data-reel-slide class="reel-hidden absolute inset-0 flex flex-col justify-between bg-band p-6 text-band-ink">
      <span class="meta">{pad(total)} / {pad(total)} · Next project</span>
      <span class="text-[clamp(36px,4.6vw,72px)] font-[550] leading-[0.96] tracking-[-0.035em]">Yours could be here.</span>
      <span class="meta">2027</span>
    </div>
  </div>
  <div class="mt-3 grid gap-2" style={`grid-template-columns: repeat(${total}, minmax(0, 1fr))`} aria-hidden="true">
    {Array.from({ length: total }, (_, i) => (
      <span class="h-[2px] overflow-hidden bg-rule"><span data-reel-bar class:list={['block h-full origin-left bg-navy', i > 0 && 'scale-x-0']}></span></span>
    ))}
  </div>
</a>
